PORT=3000
JWT_SECRET=replace-with-a-long-random-secret
TURSO_DATABASE_URL=libsql://your-database-name-your-org.turso.io
TURSO_AUTH_TOKEN=replace-with-a-database-auth-token
DATABASE_PATH=kuroneko.db
# MongoDB Atlas (Kuroneko cluster). Get the connection string from
# Atlas > Kuroneko > Connect > Drivers > copy, then fill in your
# database user + password (Atlas > Database Access).
MONGODB_URI=mongodb+srv://YOUR_USERNAME:***@cluster0.xxxxx.mongodb.net/
MONGO_DB_NAME=kuroneko
